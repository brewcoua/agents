{
  "name": "agents",
  "version": "0.1.0",
  "private": true,
  "description": "Rules, skills and Pi extensions for coding agents",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=92 --test-coverage-branches=91 --test-coverage-functions=92 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml --test-reporter=lcov --test-reporter-destination=lcov.info 'test/*.test.ts'",
    "load": "node --test test/load.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
