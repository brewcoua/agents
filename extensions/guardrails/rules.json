{
  "tools": {
    "*": "allow",
    "edit": "ask",
    "write": "ask",
    "powershell": "deny"
  },
  "bash": {
    "*": "ask",
    "echo *": "allow",
    "echo *$*": "ask",
    "ls *": "allow",
    "pwd": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "wc *": "allow",
    "file *": "allow",
    "stat *": "allow",
    "tree *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "fd *": "allow",
    "find *": "allow",
    "which *": "allow",
    "type *": "allow",
    "jq *": "allow",
    "curl *": "allow",
    "date": "allow",
    "env": "allow",
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch": "allow",
    "git branch -a*": "allow",
    "git branch -r*": "allow",
    "git branch --list*": "allow",
    "git branch --show-current*": "allow",
    "git remote -v": "allow",
    "git stash list": "allow",
    "git blame*": "allow",
    "git tag": "allow",
    "git tag --list*": "allow",
    "git worktree list*": "allow",
    "git submodule status*": "allow",
    "*-exec*": "ask",
    "*-execdir*": "ask",
    "*-delete*": "ask",
    "*-ok *": "ask",
    "*-print0*": "ask",
    "sed -i*": "ask",
    "*chmod -R*": "ask",
    "*chown -R*": "ask",
    "truncate *": "ask",
    "git branch -d*": "ask",
    "git branch -D*": "ask",
    "git branch --delete*": "ask",
    "git branch -m*": "ask",
    "git branch -M*": "ask",
    "git tag -d*": "ask",
    "git tag --delete*": "ask",
    "git rebase*": "ask",
    "git commit --amend*": "ask",
    "git cherry-pick*": "ask",
    "git revert*": "ask",
    "git merge*": "ask",
    "git merge-base*": "allow",
    "git restore*": "ask",
    "git checkout -f*": "ask",
    "git checkout --*": "ask",
    "git switch -f*": "ask",
    "git switch --discard-changes*": "ask",
    "git remote remove*": "ask",
    "git remote rm*": "ask",
    "git worktree remove*": "ask",
    "git submodule deinit*": "ask",
    "git update-ref -d*": "ask",
    "git push*": "ask",
    "git reset --hard*": "deny",
    "git clean -*f*": "deny",
    "git stash drop*": "deny",
    "git stash clear*": "deny",
    "git reflog delete*": "deny",
    "git reflog expire*": "deny",
    "git filter-branch*": "deny",
    "git filter-repo*": "deny",
    "rm -rf *": "deny",
    "rm -fr *": "deny",
    "rm -r -f *": "deny",
    "sudo *": "deny",
    "shred *": "deny",
    "mkfs*": "deny",
    "dd *": "deny",
    "xargs *": "ask"
  },
  "bashRegex": [
    {
      "pattern": "\\brm\\s+(-[a-zA-Z]*[rR][a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*[rR])\\b",
      "verdict": "deny",
      "reason": "recursive forced delete"
    },
    {
      "pattern": "\\bgit\\s+push\\b(?![^|;&]*--force-with-lease)[^|;&]*(--force|-f)\\b",
      "verdict": "deny",
      "reason": "git force-push"
    },
    {
      "pattern": "\\bgit\\s+push\\b[^|;&]*\\b(origin\\s+)?(main|master|release/)",
      "verdict": "deny",
      "reason": "push to a protected branch"
    },
    {
      "pattern": "\\bgit\\s+checkout\\s+--\\s",
      "verdict": "deny",
      "reason": "discarding working-tree changes"
    },
    {
      "pattern": "\\bdd\\s+[^|;&]*\\bof=",
      "verdict": "deny",
      "reason": "dd writing to a device"
    },
    {
      "pattern": "\\bchmod\\s+-R\\s+777\\b",
      "verdict": "deny",
      "reason": "chmod -R 777"
    },
    {
      "pattern": "\\bDROP\\s+(TABLE|DATABASE|SCHEMA)\\b",
      "flags": "i",
      "verdict": "deny",
      "reason": "dropping a database object"
    },
    {
      "pattern": "\\bTRUNCATE\\s+TABLE\\b",
      "flags": "i",
      "verdict": "deny",
      "reason": "truncating a table"
    }
  ],
  "interpreters": [
    "sh",
    "bash",
    "zsh",
    "fish",
    "dash",
    "ksh",
    "csh",
    "tcsh",
    "ash",
    "python",
    "python2",
    "python3",
    "perl",
    "ruby",
    "node",
    "php",
    "deno",
    "bun"
  ],
  "opaque": [
    "eval",
    "exec",
    "source",
    "."
  ],
  "paths": {
    "*": "allow",
    "*/.env": "deny",
    "*/.env.*": "deny",
    "*.pem": "deny",
    "*.key": "deny",
    "*.p12": "deny",
    "*.pfx": "deny",
    "*/id_rsa": "deny",
    "*/id_ed25519": "deny",
    "*/id_ecdsa": "deny",
    "*.env.example": "allow",
    "*.env.sample": "allow",
    "*.env.template": "allow",
    "*.env.dist": "allow"
  },
  "external": {
    "*": "ask",
    "/tmp/*": "allow",
    "/var/tmp/*": "allow",
    "~/.pi/agent/plans/*": "allow"
  },
  "maxOutputChars": 30000
}
